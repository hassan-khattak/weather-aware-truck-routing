# Copy to .env to override the defaults in docker-compose.yml. Never commit .env.
POSTGRES_DB=truckroute
POSTGRES_USER=truckroute
POSTGRES_PASSWORD=truckroute
SECRET_KEY=dev-only-insecure-key
# Optional: override the basemap style (the default needs no key).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Tom Tom API key and app ID for routing and geocoding. Get your own at https://developer.tomtom.com.
TOM_TOM_API_KEY=<YOUR_TOM_TOM_API_KEY>
TOM_TOM_APP_ID=<YOUR_TOM_TOM_APP_ID>